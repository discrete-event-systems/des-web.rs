# des-web — copy to .env (gitignored) or export in your shell.

# --- bind -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8130
RUST_LOG=des_web=info,info

# --- postgres (SeaORM) ------------------------------------------------------
# First set wins: DES_WEB_DATABASE_URL, DATABASE_URL, SUPABASE_DB_URL,
# RDS_DATABASE_URL, PG_DATABASE_URL. Unset = degraded mode (pages still serve).
DATABASE_URL=postgres://localhost:5432/des_web_dev
# Supabase as the Postgres provider (use the SESSION pooler / direct connection
# for dpm DDL; the transaction pooler breaks prepared statements + create/drop):
# SUPABASE_DB_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# AWS RDS (matches the pg-defs env-name chain used across k8s-cluster):
# RDS_DATABASE_URL=postgres://user:pass@your-rds-host:5432/appdb

# --- dpm (declarative migrations; scripts/dpm.sh) ---------------------------
# Server where dpm may CREATE/DROP throwaway databases. Never production.
SHADOW_DATABASE_URL=postgres://localhost:5432/postgres
# Explicit migration target (falls back to the chain above):
# TARGET_DATABASE_URL=postgres://localhost:5432/des_web_dev

# --- supabase auth (GoTrue magic-link login page) ---------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# --- optional des-rs upstream (live soccer-planner solves) ------------------
# DES_UPSTREAM_URL=http://localhost:8112
